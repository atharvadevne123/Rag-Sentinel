# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development
DATABASE_URL=sqlite:///./rag_sentinel.db
# PostgreSQL for production (uncomment and fill in credentials)
# DATABASE_URL=postgresql://sentinel:sentinel@db:5432/rag_sentinel

# PostgreSQL connection pool tuning (only applied for non-SQLite URLs)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ─── Model Artefacts ─────────────────────────────────────────────────────────
MODEL_PATH=model.joblib
METRICS_PATH=metrics.json

# ─── RAG Index ───────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=rag_index.faiss
CHUNK_SIZE=128
CHUNK_OVERLAP=16

# ─── Drift Detection ─────────────────────────────────────────────────────────
DRIFT_WINDOW_HOURS=24
DRIFT_P_THRESHOLD=0.05

# ─── Ingestion limits ────────────────────────────────────────────────────────
# Max body size for POST /ingest (bytes). Default: 500 000 (~500 KB)
MAX_INGEST_BYTES=500000

# ─── Retrain pipeline ────────────────────────────────────────────────────────
RETRAIN_LOG_PATH=retrain_log.json
# Rotate log file when it exceeds this size in bytes (default: 1 MB)
RETRAIN_LOG_MAX_BYTES=1048576

# ─── PostgreSQL (docker-compose) ──────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=rag_sentinel
